# Optional overrides for scripts/seed-e2e.js and Playwright.
# Use E2E_DATABASE_URL when your app DATABASE_URL is container-only.
# Example: 172.17.0.1 works from Docker containers, but not from macOS.

E2E_BASE_URL="http://127.0.0.1:3000"
E2E_DATABASE_URL="postgresql://user:password@localhost:5432/shared_lists"
E2E_EMAIL="e2e@example.test"
E2E_PASSWORD="e2e-password"
E2E_USER_NAME="E2E User"
E2E_USER_ID="e2e-user"
E2E_LIST_ID="e2e-list"
E2E_LIST_NAME="E2E List"
E2E_ITEM_ID="e2e-checkbox-item"
E2E_ITEM_NAME="E2E Checkbox Item"

# Override when you do not use npm.
# E2E_WEB_SERVER_COMMAND="bun run dev"
# E2E_WEB_SERVER_COMMAND="pnpm run dev"

# Set when a server is already running at E2E_BASE_URL.
# E2E_SKIP_WEB_SERVER=1
