// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]

  ownedLists       List[]   @relation("ListOwner")
  contributedLists List[]   @relation("ListContributors")
  sentInvites      Invite[] @relation("InviteSender")

  createdAgentAccesses AgentAccess[]   @relation("AgentAccessCreator")
  agentAccesses        AgentAccess[]   @relation("AgentAccessMembers")
  commands             Command[]
  clarifications       Clarification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model List {
  id          String   @id @default(cuid())
  name        String
  isArchived  Boolean  @default(false)
  createdDate DateTime @default(now())
  ownerID     String
  owner       User     @relation("ListOwner", fields: [ownerID], references: [id], onDelete: Cascade)

  contributors User[]    @relation("ListContributors")
  items        Item[]
  sections     Section[]
  invites      Invite[]
}

model Section {
  id          String   @id @default(cuid())
  name        String
  createdDate DateTime @default(now())
  listId      String
  list        List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  items       Item[]
}

model Item {
  id          String   @id @default(cuid())
  name        String
  completed   Boolean  @default(false)
  description String   @default("")
  createdDate DateTime @default(now())
  order       Int      @default(0)

  listID    String
  list      List     @relation(fields: [listID], references: [id], onDelete: Cascade)
  sectionID String?
  section   Section? @relation(fields: [sectionID], references: [id], onDelete: Cascade)

  normalized String      @default("")
  aliases    ItemAlias[]
}

model Invite {
  id           String   @id @default(cuid())
  inviterID    String
  inviterName  String
  inviteeEmail String
  listID       String
  listName     String
  status       String   @default("pending") // "pending", "accepted", "declined"
  createdDate  DateTime @default(now())

  inviter User @relation("InviteSender", fields: [inviterID], references: [id], onDelete: Cascade)
  list    List @relation(fields: [listID], references: [id], onDelete: Cascade)
}

model ItemAlias {
  id          String   @id @default(cuid())
  itemId      String
  alias       String
  normalized  String
  locale      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, normalized])
}

// A token-based way in for agents (Claude Code, NanoClaw, ...). It acts for
// one person or for a household; a household sees only the lists that every
// member can see. Only the SHA-256 hash of the token secret is stored.
model AgentAccess {
  id          String    @id @default(cuid())
  label       String // channel name, e.g. "claude-code"
  kind        String // "person" | "household"
  tokenId     String    @unique // public 8-character part of the token
  tokenHash   String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  createdBy      User            @relation("AgentAccessCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members        User[]          @relation("AgentAccessMembers")
  commands       Command[]
  clarifications Clarification[]
}

// One user intent (a click, a tool call, a sentence). Its ListEvents are the
// changes it made; undo works on whole commands.
model Command {
  id          String    @id @default(cuid())
  seq         Int       @unique @default(autoincrement()) // stable order for commands created in the same millisecond
  actorUserId String?
  accessId    String?
  channel     String // e.g. "web", "v1", "claude-code"
  origin      String // "web" | "v1" | "tool" | "agent"
  inputText   String?
  sentence    Boolean   @default(false) // entry command of an agent sentence; counts against the daily limit
  kind        String // "change" | "undo"
  undoState   String    @default("none") // "none" | "undone" | "partial"
  undoneAt    DateTime?
  undoOfId    String?
  createdAt   DateTime  @default(now())

  actor          User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  access         AgentAccess?    @relation(fields: [accessId], references: [id], onDelete: SetNull)
  undoOf         Command?        @relation("CommandUndo", fields: [undoOfId], references: [id], onDelete: SetNull)
  undoneBy       Command[]       @relation("CommandUndo")
  events         ListEvent[]
  clarifications Clarification[]

  @@index([actorUserId, createdAt])
  @@index([accessId, createdAt])
}

// A single change to list content. listId, itemId and sectionId carry no
// foreign keys so events outlive deleted lists, sections and items. before and
// after hold only the changed fields. Event types are string constants in code.
model ListEvent {
  id        String   @id @default(cuid())
  seq       Int      @unique @default(autoincrement()) // stable order within a command
  commandId String
  type      String
  listId    String
  itemId    String?
  sectionId String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  command Command @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([listId, createdAt])
  @@index([commandId])
}

// An open question from the list agent. options holds, per option, a label
// and a prepared tool call; answering runs that call and attaches its events
// to the command of the original sentence.
model Clarification {
  id          String    @id @default(cuid())
  actorUserId String?
  accessId    String?
  commandId   String
  question    String
  options     Json
  inputText   String
  expiresAt   DateTime
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  actor   User?        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  access  AgentAccess? @relation(fields: [accessId], references: [id], onDelete: Cascade)
  command Command      @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([accessId, createdAt])
}
